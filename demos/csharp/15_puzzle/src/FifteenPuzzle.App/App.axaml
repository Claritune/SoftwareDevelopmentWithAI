<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FifteenPuzzle.App.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#17263D" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1C3150" />
        <SolidColorBrush x:Key="PanelLineBrush" Color="#355070" />
        <SolidColorBrush x:Key="BoardBrush" Color="#071126" />
        <SolidColorBrush x:Key="EmptyTileBrush" Color="#171E30" />
        <SolidColorBrush x:Key="TileBrush" Color="#E5ECF5" />
        <SolidColorBrush x:Key="TileHoverBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MovableTileBrush" Color="#FFB900" />
        <SolidColorBrush x:Key="AccentBrush" Color="#087DF5" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="TileTextBrush" Color="#0B172D" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A9B9CF" />
        <SolidColorBrush x:Key="LineBrush" Color="#355070" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Avenir Next, SF Pro Display" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="LetterSpacing" Value="0" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="37" />
            <Setter Property="FontWeight" Value="Heavy" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Border.movePill">
            <Setter Property="Background" Value="#0C1A31" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="TextBlock.moveLabel">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.moveValue">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.helpStrip">
            <Setter Property="Background" Value="#0C1A31" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Border.helpStrip TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Border.stat">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.board">
            <Setter Property="Background" Value="{DynamicResource BoardBrush}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderBrush" Value="#304767" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Margin" Value="7" />
            <Setter Property="Width" Value="98" />
            <Setter Property="Height" Value="98" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{DynamicResource TileBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TileTextBrush}" />
            <Setter Property="FontFamily" Value="Avenir Next, SF Pro Display" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Heavy" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{DynamicResource TileTextBrush}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.tile.movable">
            <Setter Property="Background" Value="{DynamicResource MovableTileBrush}" />
        </Style>
        <Style Selector="Button.tile.empty">
            <Setter Property="Background" Value="{DynamicResource EmptyTileBrush}" />
        </Style>
        <Style Selector="Button.tile:disabled">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource TileBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TileTextBrush}" />
        </Style>
        <Style Selector="Button.tile.empty:disabled">
            <Setter Property="Background" Value="{DynamicResource EmptyTileBrush}" />
        </Style>
        <Style Selector="Button.tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource TileHoverBrush}" />
        </Style>
        <Style Selector="Button.tile.movable:pointerover">
            <Setter Property="Background" Value="#FFC633" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.scoreLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
    </Application.Styles>
</Application>